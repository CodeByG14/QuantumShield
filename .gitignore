# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated outputs (do not commit)
assessment.json
migration_plan.json
cbom.json
scored_output.json
cdxgen-output.json
benchmark_results.json
compliance_report.json
compliance_report.md
diff.json
*.db

# Test fixtures / samples
samples/
# Generated Phase 7 validation reports
/validation/out/

# Local PostgreSQL credentials
.env

# Ignore all markdown files strictly inside the frontend directory
frontend/**/*.md

# Ignore all environment variable files (secrets) anywhere in the project
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.text

# Alternative wildcard to catch any custom env files
.env*
!.env.example

# Standard React/Frontend ignores
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.eslintcache
frontend/coverage/
